{
  "name": "hhil-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy:once": "convex dev --once",
    "seed": "convex run seed:demo",
    "rescore": "convex run matching:rescore",
    "end-event": "convex run event:end",
    "agent": "tsx --env-file=.env.local agent/index.ts",
    "agent:console": "AGENT_TRANSPORT=console tsx --env-file=.env.local agent/index.ts",
    "typecheck": "tsc -p convex --noEmit && tsc -p . --noEmit",
    "e2e": "tsx --env-file=.env.local scripts/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "convex": "^1.48.0",
    "spectrum-ts": "^12.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
