# Copy to .env.local and fill in. Never commit the real file.

# Written for you by `npx convex dev` on first run
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Claude Platform > API Keys. Used by the agent worker.
# Convex functions read their own copy: npx convex env set ANTHROPIC_API_KEY <key>
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Photon dashboard > Spectrum project
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# photon = real iMessage, console = chat with the agent in the terminal
AGENT_TRANSPORT=photon
