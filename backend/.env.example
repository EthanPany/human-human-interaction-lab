# Copy to .env.local and fill in. Never commit the real file.

# Written for you by `npx convex dev` on first run
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Claude Platform > API Keys. Used by the agent worker.
# Convex functions read their own copy: npx convex env set ANTHROPIC_API_KEY <key>
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Photon 2.0 (app.beta.photon.codes): project id (pho_prj_...) and a project API key (pho_sk_...)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Only for the legacy Photon Spectrum platform (app.photon.codes)
PHOTON_PROJECT_SECRET=
# Photon Spectrum (app.photon.codes): a dedicated line. Set AGENT_LINE in the Convex env to switch to it.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Leave empty to pick automatically: photon2 when PHOTON_API_KEY is set.
# console = chat with the agent in the terminal
AGENT_TRANSPORT=
